{
  "name": "Booking",
  "type": "object",
  "properties": {
    "service": {
      "type": "string",
      "enum": [
        "hotels",
        "flights",
        "transfers",
        "cars",
        "trains"
      ]
    },
    "title": {
      "type": "string"
    },
    "destination": {
      "type": "string"
    },
    "check_in": {
      "type": "string",
      "format": "date"
    },
    "check_out": {
      "type": "string",
      "format": "date"
    },
    "guests": {
      "type": "number",
      "default": 1
    },
    "rooms": {
      "type": "number",
      "default": 1
    },
    "total_price": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "cancelled"
      ],
      "default": "pending"
    },
    "reference": {
      "type": "string"
    },
    "details": {
      "type": "string"
    }
  },
  "required": [
    "service",
    "title",
    "destination"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}