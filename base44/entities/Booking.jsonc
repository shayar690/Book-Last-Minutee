{
  "name": "Booking",
  "type": "object",
  "properties": {
    "service": {
      "type": "string",
      "enum": [
        "hotels",
        "flights",
        "transfers",
        "cars",
        "trains"
      ]
    },
    "title": {
      "type": "string",
      "description": "Hotel, flight, or service name"
    },
    "destination": {
      "type": "string",
      "description": "Country or main destination"
    },
    "city": {
      "type": "string"
    },
    "check_in": {
      "type": "string",
      "format": "date"
    },
    "check_out": {
      "type": "string",
      "format": "date"
    },
    "guests": {
      "type": "number",
      "default": 1,
      "description": "Total guests"
    },
    "adults": {
      "type": "number",
      "default": 1
    },
    "children": {
      "type": "number",
      "default": 0
    },
    "rooms": {
      "type": "number",
      "default": 1
    },
    "nights": {
      "type": "number"
    },
    "total_price": {
      "type": "number"
    },
    "daily_rate": {
      "type": "number",
      "description": "Average daily rate"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "completed",
        "cancelled"
      ],
      "default": "pending"
    },
    "reference": {
      "type": "string",
      "description": "Booking reference / PNR"
    },
    "guest_name": {
      "type": "string"
    },
    "guest_email": {
      "type": "string"
    },
    "room_type": {
      "type": "string"
    },
    "meal": {
      "type": "string"
    },
    "free_cancellation": {
      "type": "boolean"
    },
    "cancellation_date": {
      "type": "string",
      "format": "date"
    },
    "payment_due": {
      "type": "string",
      "format": "date"
    },
    "paid": {
      "type": "boolean",
      "default": false
    },
    "paid_on": {
      "type": "string",
      "format": "date"
    },
    "payment_type": {
      "type": "string"
    },
    "supplier_id": {
      "type": "string"
    },
    "invoice_id": {
      "type": "string"
    },
    "details": {
      "type": "string",
      "description": "Free-text notes / original rate name"
    }
  },
  "required": [
    "service",
    "title",
    "destination"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}